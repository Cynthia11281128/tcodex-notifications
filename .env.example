# Optional Mac configuration. Copy to .env, edit locally, then load explicitly:
# set -a; . ./.env; set +a
# The listener does not automatically read or execute this file.
TCODEX_NOTIFY_SERVER_DIR='/absolute/path/to/tcodex-notification'
TCODEX_NOTIFY_CHANNEL='default'
